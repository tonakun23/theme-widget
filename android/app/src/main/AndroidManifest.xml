<?xml version="1.0" encoding="utf-8"?>
<!-- Khung Android — Giai đoạn 1. Chưa build được (thiếu JDK + Android SDK). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- V1 hoàn toàn ngoại tuyến: KHÔNG xin quyền Internet (NFR-09). -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.WidgetTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trình chỉnh sửa theme (SC-05). Mở từ thư viện, từ widget, hoặc
             từ màn hình cấu hình khi thêm widget (ACTION_APPWIDGET_CONFIGURE). -->
        <activity
            android:name=".editor.ThemeEditorActivity"
            android:exported="false" />

        <!-- 4 loại widget V1 (F-01..F-05). Mỗi provider trỏ tới màn hình cấu
             hình để mở trình chọn theme ngay khi thêm widget (UC-01). -->
        <receiver
            android:name=".widget.ClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CalendarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NoteWidgetProvider"
            android:exported="true"
            android:label="@string/widget_note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/note_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BatteryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <!-- Chia sẻ gói theme qua FileProvider (Giai đoạn 5). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Nhận đổi sáng/tối + đổi hình nền để cập nhật widget (UC-06).
             TODO Giai đoạn 4: đăng ký BroadcastReceiver CONFIGURATION_CHANGED. -->
    </application>
</manifest>
