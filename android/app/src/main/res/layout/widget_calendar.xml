<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">
    <!-- Anh nen rieng tung widget (Giai doan 3): nam duoi noi dung. -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <!-- TextClock tự cập nhật theo hệ thống (đổi ngày lúc nửa đêm). -->
        <TextClock
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="d"
            android:format24Hour="d"
            android:textSize="20sp" />
        <TextClock
            android:id="@+id/widget_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM yyyy"
            android:format24Hour="EEEE, MMMM yyyy"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lịch"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
